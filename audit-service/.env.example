# Puerto del servicio (interno — nginx en la misma VPS es lo único que le habla)
PORT=4001

# Interfaz a la que se liga el servidor.
# - Corriendo suelto (fuera de Docker): 127.0.0.1, nunca 0.0.0.0.
# - Desplegado en la VPS vía Docker + Traefik (ver deploy/DEPLOY.md): el
#   docker-compose.yml de despliegue fija esto a 0.0.0.0. Es seguro porque el
#   contenedor no publica ningún puerto — solo Traefik, en la red Docker
#   interna, puede alcanzarlo; internet nunca ve este puerto directamente.
AUDIT_BIND_HOST=127.0.0.1

# MongoDB propio del servicio de auditoría — credenciales que la app
# principal NUNCA debe tener. En el despliegue Docker, "localhost" se
# reemplaza por el nombre del servicio "mongo" dentro de la red interna.
AUDIT_MONGODB_URI=mongodb://localhost:27017/audit

# Días de retención "caliente" antes de que el índice TTL elimine el evento.
AUDIT_RETENTION_DAYS=90

# Tokens de servicio — uno de ESCRITURA por cada app institucional (nunca
# compartido entre apps: si uno se filtra, se rota solo ese), más uno de
# LECTURA institucional compartido. Generar cada uno con, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Una app sin su variable configurada simplemente no puede autenticar todavía
# — no rompe el servicio ni a las demás apps. Ver utils/sources.js para la
# lista completa de apps soportadas.
AUDIT_WRITE_TOKEN_RL=
AUDIT_WRITE_TOKEN_PORTAL=
AUDIT_WRITE_TOKEN_SGI=
AUDIT_WRITE_TOKEN_NUNI=
AUDIT_WRITE_TOKEN_TRADUCTIVIA=
AUDIT_READ_TOKEN=
